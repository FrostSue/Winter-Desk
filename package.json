{
  "name": "winter-desk",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive ambient winter desktop companion for Windows",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "tsc && vite build && electron .",
    "package": "tsc && vite build && electron-packager . WinterDesk --platform=win32 --arch=x64 --icon=assets/icon.ico --out=release --overwrite"
  },
  "dependencies": {
    "pixi.js": "^8.6.6"
  },
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "electron": "^33.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-electron": "^0.29.0"
  }
}
